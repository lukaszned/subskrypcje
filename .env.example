# ============================================================
# Sub-Sentry frontend environment
# ============================================================
# Copy this file to .env for local development.
# Do not commit real production values.

# Supabase public client config. The anon key is public by design.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL.
# Release builds must use the public HTTPS backend URL.
EXPO_PUBLIC_API_BASE_URL=https://api.your-domain.example

# Local development examples:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3000
