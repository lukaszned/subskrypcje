# ============================================================
# Sub-Sentry / FlowPay — Frontend Environment Variables
# ============================================================
# Skopiuj ten plik do .env i uzupełnij wartościami.
# Plik .env NIE jest commitowany do repo (jest w .gitignore).
# Plik .env.example JEST commitowany — służy jako dokumentacja.
# ============================================================

# Supabase — klucze znajdziesz w: https://supabase.com/dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API — adres backendu kolegi
# Development (lokalnie):
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Production (gdy backend będzie wdrożony):
# EXPO_PUBLIC_API_BASE_URL=https://api.subsentry.app
